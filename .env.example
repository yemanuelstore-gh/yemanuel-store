# Supabase — required in Phase 2 (database, storage, authentication).
# Copy this file to .env.local and fill in the values from your Supabase
# project dashboard. Never commit real credentials.
#
# NEXT_PUBLIC_* variables are inlined at build time — restart the
# development server (or rebuild) after changing them.

# Public project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key — safe for the browser, but must never be treated as a secret.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — SERVER ONLY. Never expose this to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Payments (Phase 8) — SERVER ONLY. Optional.
# A payment provider is only activated when PAYMENT_PROVIDER is set to a real,
# supported provider id (e.g. "hubtel", "paystack", "korba"). Until then,
# provider-backed methods (mobile money, card) are NOT offered at checkout —
# nothing is simulated. Bank transfer and cash (verified manually in admin)
# are always available.
#
# PAYMENT_PROVIDER=
# PAYMENT_PROVIDER_METHODS=mobile_money,card
# PAYMENT_PROVIDER_WEBHOOK_SECRET=
# Payload signature header values differ per provider; the webhook route
# accepts x-hubtel-signature / x-paystack-signature / x-korba-signature /
# x-signature and verifies them with an HMAC-SHA256 of the raw body using
# PAYMENT_PROVIDER_WEBHOOK_SECRET.
#
# Hubtel adapter credentials (SERVER ONLY) — required before Hubtel-backed
# methods are offered. Get these from the Hubtel developer portal.
# HUBTEL_CLIENT_ID=
# HUBTEL_CLIENT_SECRET=
# HUBTEL_MERCHANT_ACCOUNT_NUMBER=